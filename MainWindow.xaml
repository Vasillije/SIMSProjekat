        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VasilijeSIMS"
        mc:Ignorable="d"
        Title="Login" Height="200" Width="320">
    <Grid>
        <Grid>
            <Button Content="Confirm" HorizontalAlignment="Left" Margin="179,121,0,0" VerticalAlignment="Top" Height="21" Width="82" Click="Confirm_Click"/>
            <TextBox  x:Name="email" HorizontalAlignment="Left" Margin="122,36,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="139"/>
            <TextBlock HorizontalAlignment="Left" Margin="20,34,0,0" TextWrapping="Wrap" Text="E-mail:" VerticalAlignment="Top"/>
            <TextBlock HorizontalAlignment="Left" Margin="20,77,0,0" TextWrapping="Wrap" Text="Password:" VerticalAlignment="Top"/>
            <PasswordBox x:Name="password" HorizontalAlignment="Left" Margin="122,79,0,0" VerticalAlignment="Top" Width="138"/>
        </Grid>
    </Grid>
</Window>
