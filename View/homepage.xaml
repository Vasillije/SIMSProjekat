<Window x:Class="VasilijeSIMS.View.homepage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VasilijeSIMS.View"
        mc:Ignorable="d"
        Title="homepage" Height="450" Width="800">
    <Grid>
        <Button x:Name="users" Content="USERS" HorizontalAlignment="Left" Margin="30,31,0,0" BorderThickness="0" VerticalAlignment="Top" Height="38" Width="130" Click="Users_Click"/>
        <Button x:Name="logout" Content="Logout" HorizontalAlignment="Left" Margin="720,31,0,0" VerticalAlignment="Top" Click="Logout_Click"/>
        <Button x:Name="medicines" Content="MEDICINES" HorizontalAlignment="Left" Margin="160,31,0,0" VerticalAlignment="Top" BorderThickness="0" Height="38" Width="130" Click="Medicines_Click"/>
    </Grid>
</Window>
