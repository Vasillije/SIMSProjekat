<Window x:Class="VasilijeSIMS.View.UpdateUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VasilijeSIMS.View"
        mc:Ignorable="d"
        Title="Update user" Height="530" Width="333">
    <Grid Margin="0,0,0,1">
        <Label Content="JMBG:" HorizontalAlignment="Left" Margin="51,36,0,0" VerticalAlignment="Top"/>
        <Label Content="E-mail:" HorizontalAlignment="Left" Margin="51,86,0,0" VerticalAlignment="Top"/>
        <Label Content="Password:" HorizontalAlignment="Left" Margin="51,136,0,0" VerticalAlignment="Top"/>
        <Label Content="Name:" HorizontalAlignment="Left" Margin="51,186,0,0" VerticalAlignment="Top"/>
        <Label Content="Last name:" HorizontalAlignment="Left" Margin="51,236,0,0" VerticalAlignment="Top"/>
        <Label Content="Phone number:" HorizontalAlignment="Left" Margin="51,286,0,0" VerticalAlignment="Top"/>
        <TextBox Name="jmbg" HorizontalAlignment="Left" Margin="152,40,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="email" HorizontalAlignment="Left" Margin="152,90,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="password" HorizontalAlignment="Left" Margin="152,140,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="name" HorizontalAlignment="Left" Margin="152,190,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="surname" HorizontalAlignment="Left" Margin="152,240,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="phone" HorizontalAlignment="Left" Margin="152,290,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="53,421,0,0" VerticalAlignment="Top" Click="Cancel_Click"/>
        <Button Content="Confirm" HorizontalAlignment="Left" Margin="224,421,0,0" Click="Confirm_Click" VerticalAlignment="Top" RenderTransformOrigin="0.25,-5.429"/>
        <Label Content="User type:" HorizontalAlignment="Left" Margin="50,338,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cbUserType" HorizontalAlignment="Left" Margin="154,340,0,0" VerticalAlignment="Top" Width="120">
            <ComboBoxItem Content="Pharmacist"/>
            <ComboBoxItem Content="Doctor"/>
        </ComboBox>
    </Grid>
</Window>
