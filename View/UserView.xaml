<Window x:Class="VasilijeSIMS.View.UserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VasilijeSIMS.View"
        mc:Ignorable="d"
        Title="User view" Height="450" Width="800">
    <Grid>
        <!--<DataGrid x:Name="UserTable" Margin="5,68,35,75" CanUserAddRows="False" AutoGenerateColumns="False" ItemsSource="{Binding users}"  > -->
        <DataGrid IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding users}" x:Name="UsersTable" Margin="5,68,35,75" SelectionChanged="UsersTable_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="JMBG" Width="*" Binding="{Binding Jmbg}"/>
                <DataGridTextColumn Header="Email" Width="*" Binding="{Binding Email}"/>
                <DataGridTextColumn Header="Name" Width="*"  Binding="{Binding Name}"/>
                <DataGridTextColumn Header="LastName" Width="*"  Binding="{Binding LastName}"/>
                <DataGridTextColumn Header="Phone nubmer" Width="*"  Binding="{Binding PhoneNumber}"/>
                <DataGridTextColumn Header="User type" Width="*" Binding="{Binding TypeUser}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox HorizontalAlignment="Left" Margin="577,31,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button Content="Create user" HorizontalAlignment="Left" Margin="15,380,0,0" VerticalAlignment="Top" Width="102" Click="CreateUserClick"/>
        <Button Content="Update user" HorizontalAlignment="Left" Margin="337,380,0,0" VerticalAlignment="Top" Width="102" Click="Update_Click"/>
        <Button Content="Delete user" HorizontalAlignment="Left" Margin="665,380,0,0" VerticalAlignment="Top" Width="102" Click="Delete_Click"/>
        <Button Content="Back" HorizontalAlignment="Left" Margin="725,30,0,0" VerticalAlignment="Top" Width="40" Click="Back_Click"/>
        <Button Content="Block selected user" HorizontalAlignment="Left" Margin="8,30,0,0" VerticalAlignment="Top" Width="124" Click="Block_Click"/>
        <Button Content="Unblock selected user" HorizontalAlignment="Left" Margin="161,30,0,0" VerticalAlignment="Top" Width="124" Click="Unblock_Click"/>
    </Grid>
</Window>
